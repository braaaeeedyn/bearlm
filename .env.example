# BearLM configuration. Copy to `.env` and fill in as needed.
# NEVER commit real secrets — `.env` is gitignored.

# Which stack to use:
#   local  = Ollama (llama3.1:8b + nomic-embed-text) + Chroma   [no API keys needed]
#   openai = OpenAI (gpt-4o-mini + text-embedding-3-small) + MongoDB Atlas
BACKEND=local

# --- OpenAI backend only (leave blank when BACKEND=local) --------------------
OPENAI_API_KEY=
MONGODB_URI=

# --- Local backend (Ollama + Chroma) ----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b        # use qwen2.5:3b if under ~8GB VRAM
OLLAMA_EMBED_MODEL=nomic-embed-text  # 768-dim embeddings
OLLAMA_NUM_CTX=8192
CHROMA_DIR=./db
CHROMA_COLLECTION=bearlm_chunks

# Retrieval + reranking
RETRIEVAL_K=4
RERANK_ENABLED=true                  # true = retrieve 15, rerank, keep 4 (course corpus)
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=15
RERANK_TOP_N=4

# --- Projects, uploads & anti-hallucination ---------------------------------
PROJECT_FALLBACK_TO_CORPUS=true      # project answers fall back to the course corpus
RERANK_MIN_SCORE=0.02                # confidence gate: drop chunks below this (0..1)
MIN_RELEVANCE=0.30                   # vector-relevance floor (reserved)
# PROJECTS_DIR=./data/projects       # where projects are stored (default shown)
# UPLOADS_DIR=./data/uploads         # where ad-hoc uploads are stored (default shown)
