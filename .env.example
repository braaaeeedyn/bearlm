# BearLM configuration. Copy to `.env` and fill in as needed.
# NEVER commit real secrets — `.env` is gitignored.

# Which stack to use:
#   local  = Ollama (llama3.1:8b + nomic-embed-text) + Chroma   [no API keys needed]
#   openai = OpenAI (gpt-4o-mini + text-embedding-3-small) + MongoDB Atlas
BACKEND=local

# --- OpenAI backend only (leave blank when BACKEND=local) --------------------
OPENAI_API_KEY=
MONGODB_URI=

# --- Local backend (Ollama + Chroma) ----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b        # use qwen2.5:3b if under ~8GB VRAM
OLLAMA_EMBED_MODEL=nomic-embed-text  # 768-dim embeddings
OLLAMA_NUM_CTX=8192
CHROMA_DIR=./db
CHROMA_COLLECTION=bearlm_chunks

# Retrieval + reranking
RETRIEVAL_K=4
RERANK_ENABLED=false                 # true = retrieve 15, rerank, keep 4
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=15
RERANK_TOP_N=4
